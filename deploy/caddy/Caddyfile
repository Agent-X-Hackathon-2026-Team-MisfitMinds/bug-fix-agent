# Automatic HTTPS for the production single-origin deployment.
# SITE_DOMAIN comes from the environment (compose passes it through).
# One public origin serves everything: the web app proxies /api, /auth and
# /webhooks to the API container, so the GitHub App needs only this domain.
{$SITE_DOMAIN} {
	# SSE run-status streams must arrive unbuffered.
	flush_interval -1
	reverse_proxy web:3000
}
