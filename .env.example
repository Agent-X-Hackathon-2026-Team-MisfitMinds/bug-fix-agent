# Environment variables example - never commit real values
# Real values go into each developer's .env file or server-side secrets

# GitHub App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Server-side only - never use NEXT_PUBLIC_ for these
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY=your_github_private_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API
API_BASE_URL=http://localhost:8000
API_SECRET_KEY=change_this_to_a_secure_random_value

# Docker
DOCKER_IMAGE_TAG=latest