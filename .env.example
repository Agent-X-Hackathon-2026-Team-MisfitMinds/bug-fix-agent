# Environment variables example - never commit real values.
# Copy to .env (git-ignored) and fill in. Real values stay server-side.

# GitHub App (server-only)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_CLIENT_ID=your_github_client_id
GITHUB_APP_CLIENT_SECRET=your_github_client_secret
GITHUB_APP_PRIVATE_KEY=your_github_private_key_pem
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret
GITHUB_INSTALLATION_ID=your_installation_id
GITHUB_DEMO_REPO=owner/seeded-demo-repo

# Session and OAuth (server-only)
SESSION_SECRET=change_this_to_a_secure_random_value
COOKIE_SECURE=true
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# LLM provider (server-only, free tier)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=your_llm_base_url

# Public values (safe to expose to the browser)
NEXT_PUBLIC_GITHUB_APP_ID=your_github_app_id
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
MAINTENANCE_MODE=false

# Docker
DOCKER_IMAGE_TAG=latest
